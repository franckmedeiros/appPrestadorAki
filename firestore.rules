rules_version = '2';

// Modelo de dados: cada prestador é um documento em /providers/{uid}, onde
// {uid} É o UID do Firebase Auth (1 prestador = 1 conta, mesmo desenho do
// MVP anterior em Postgres — "staff" multiusuário por prestador fica pra
// quando essa história entrar no backlog). Todo o resto dos dados de
// negócio vive em subcoleções de /providers/{uid}, o que torna a regra de
// isolamento multi-tenant trivial: "só o dono enxerga o que é dele".
//
// `budgets`, `jobs` e os tokens públicos de orçamento (coleção separada,
// não listada aqui) têm escrita mais restrita porque a numeração
// sequencial, o versionamento e a criação automática de job precisam ficar
// consistentes — isso é feito pelas Cloud Functions (Admin SDK, que
// ignora estas regras), não pelo app direto.
service cloud.firestore {
  match /databases/{database}/documents {
    function isOwner(providerId) {
      return request.auth != null && request.auth.uid == providerId;
    }

    match /providers/{providerId} {
      allow read, update: if isOwner(providerId);
      // Criado uma única vez, logo após o cadastro (ver
      // AuthRepository.register no app) — o próprio usuário recém-criado
      // é quem grava o próprio documento de prestador.
      allow create: if isOwner(providerId);
      allow delete: if false;

      match /customers/{customerId} {
        allow read, write: if isOwner(providerId);
      }

      match /technicalVisits/{visitId} {
        allow read, write: if isOwner(providerId);
      }

      match /appointments/{appointmentId} {
        allow read, write: if isOwner(providerId);
      }

      match /locationSessions/{sessionId} {
        allow read, write: if isOwner(providerId);
      }

      // Orçamentos (módulo formal, ligado a Clientes — ver
      // lib/features/budgets/): versão simples implementada em
      // 2026-08, direto do app (BudgetsRepository), sem numeração
      // sequencial/versionamento/job automático (o desenho mais
      // ambicioso com Cloud Functions/`jobs` em functions/src/budgets.ts
      // nunca chegou a ser ligado ao app — fica como código morto).
      //
      // Desde então (pedido do Franck) um orçamento também pode nascer de
      // um pedido de cliente pelo marketplace (ver `Budget.clientUid`/
      // `BudgetStatus`) — por isso, além do dono (`isOwner`), um cliente
      // autenticado também pode criar/atualizar um documento aqui, de
      // forma bem restrita:
      //   - `create`: só um orçamento `pendente`, com o próprio uid como
      //     `clientUid`, sem itens/preço nem desconto (o prestador é quem
      //     preenche isso depois, ao enviar) e só com os campos abaixo.
      //   - `update`: só a partir de `enviado` (o prestador já respondeu),
      //     só pra `aprovado`/`recusado`, e só mexendo em `status`/
      //     `rejectedBy`/`updatedAt` — preço/itens continuam intocáveis
      //     pelo cliente.
      // O aceite final (`aprovado` -> `aceito`, que cria o compromisso na
      // agenda) só o prestador faz, então cai direto em `isOwner` — sem
      // regra adicional.
      match /budgets/{budgetId} {
        // Um único documento de cada vez (abrir um orçamento específico)
        // — aqui `isOwner(providerId)` é perfeitamente seguro combinado
        // com OR, porque o Firestore já sabe exatamente qual documento
        // está sendo pedido (o caminho inteiro já veio resolvido no
        // request, não precisa provar nada pra um conjunto de resultados
        // em aberto).
        allow get: if isOwner(providerId) ||
          (request.auth != null && request.auth.uid == resource.data.get('clientUid', null));

        // Consultas (`list`) — inclusive a `collectionGroup('budgets')`
        // que o CLIENTE usa em "Meus orçamentos" pra ver pedidos em
        // QUALQUER prestador (ver BudgetRequestsRepository.watchMine).
        // Isso NÃO pode usar `isOwner(providerId)` aqui: o Firestore
        // recusa a `collectionGroup` inteira quando a regra mistura uma
        // variável do CAMINHO do documento (`providerId`, que varia por
        // prestador) com uma condição sobre CAMPO do documento
        // (`clientUid`) dentro de um OR — mesmo sendo logicamente seguro
        // (o filtro `where('clientUid', ...)` da query já garante que só
        // vem documento do próprio cliente), ele não consegue provar isso
        // pra uma query em aberto e nega a consulta inteira com
        // PERMISSION_DENIED (limitação documentada do próprio Firebase).
        // Por isso usamos `providerUid` — o MESMO uid do prestador, só
        // que gravado como campo do documento — em vez de `isOwner`: aí
        // as duas metades do OR são só sobre campos, e o Firestore
        // consegue validar a query (ver `Budget.providerUid`/
        // `BudgetsRepository.create`/`BudgetRequestsRepository.create`,
        // que sempre gravam esse campo).
        // Acesso direto ao campo (não `resource.data.get(...)`), e
        // DUAS declarações `allow list` separadas em vez de uma com OR
        // — nenhuma dessas variações mudou o resultado de um
        // PERMISSION_DENIED persistente na collectionGroup query do
        // cliente (testado inclusive com `allow list: if request.auth
        // != null` totalmente aberto, que TAMBÉM foi negado — ver
        // investigação em 2026-09-01/02). Isso descarta a lógica da
        // condição como causa: se até "qualquer autenticado" nega, o
        // request está chegando ao servidor sem `request.auth`
        // populado (observado junto com instabilidade de rede do
        // aparelho de teste — DNS falhando pra
        // firestore.googleapis.com e timeout no bootstrap de auth).
        // Mantendo a forma mais segura e correta (campo direto, duas
        // declarações) — quando a causa de ambiente for confirmada/
        // resolvida, isso deve funcionar sem precisar mexer de novo
        // aqui.
        allow list: if request.auth != null && request.auth.uid == resource.data.providerUid;
        allow list: if request.auth != null && request.auth.uid == resource.data.clientUid;

        allow create: if isOwner(providerId) ||
          (request.auth != null &&
           request.auth.uid == request.resource.data.clientUid &&
           request.resource.data.providerUid == providerId &&
           request.resource.data.status == 'pendente' &&
           request.resource.data.items == [] &&
           request.resource.data.discountCents == 0 &&
           request.resource.data.keys().hasOnly([
             'clientUid', 'providerUid', 'providerDirectoryId', 'providerName', 'category',
             'customerName', 'requestDescription', 'preferredDate',
             'addressText', 'date', 'items', 'discountCents', 'status',
             'createdAt', 'updatedAt'
           ]));

        allow update: if isOwner(providerId) ||
          (request.auth != null &&
           request.auth.uid == resource.data.get('clientUid', null) &&
           resource.data.status == 'enviado' &&
           request.resource.data.status in ['aprovado', 'recusado'] &&
           request.resource.data.diff(resource.data).affectedKeys()
             .hasOnly(['status', 'rejectedBy', 'updatedAt']));

        allow delete: if isOwner(providerId);

        match /versions/{versionId} {
          allow read: if isOwner(providerId);
          allow write: if false;
        }
        match /changeRequests/{requestId} {
          allow read: if isOwner(providerId);
          allow write: if false;
        }
      }

      // Jobs só nascem automaticamente quando uma Cloud Function aprova um
      // orçamento — o prestador pode ler e atualizar status de execução
      // (a_caminho/chegou/concluído), mas não cria nem apaga um job à mão.
      match /jobs/{jobId} {
        allow read, update: if isOwner(providerId);
        allow create, delete: if false;
      }
    }

    // Perfil do lado cliente do marketplace (pivot: o PrestadorAki passou
    // a ter dois lados — ver DATA_MODEL.md). Mesmo desenho de isolamento
    // que /providers/{uid}.
    match /clients/{clientUid} {
      allow read, update: if isOwner(clientUid);
      allow create: if isOwner(clientUid);
      allow delete: if false;

      match /favorites/{listingId} {
        allow read, write: if isOwner(clientUid);
      }

      // Central de notificações (sininho — ver
      // functions/src/notifications.ts e NotificationBell/
      // NotificationsScreen no app). Só as Cloud Functions (Admin SDK,
      // que ignora estas regras) criam um item aqui — o app só lê, marca
      // como lida (`update`) e apaga (`delete`) as próprias.
      match /notifications/{notificationId} {
        allow read, update, delete: if isOwner(clientUid);
        allow create: if false;
      }
    }

    // Diretório público de prestadores (marketplace) — leitura é pública
    // de propósito (mudança de ideia: buscar um prestador nunca deve
    // exigir conta, só ações como favoritar/solicitar orçamento pedem
    // login, na hora). Não tem problema nenhum documento aqui vazar pra
    // alguém sem sessão: só guarda nome/categoria/cidade (nunca contato —
    // ver a ressalva de LGPD no README/DATA_MODEL.md), o mesmo dado que
    // apareceria numa lista telefônica ou num catálogo do Google Maps.
    // Escrita continua restrita: só quando o id do documento é o próprio
    // uid de quem está escrevendo (perfil "reivindicado": o prestador
    // mantendo os próprios dados públicos em dia — ver
    // ProviderDirectoryRepository.upsertOwnListing no app). Entradas "não
    // reivindicadas" (carga inicial/curadoria manual, sem providerUid) só
    // são criadas/editadas via Admin SDK — o app nunca cria uma entrada
    // não reivindicada sozinho.
    match /providerDirectory/{listingId} {
      allow read: if true;

      allow create: if isOwner(listingId);
      allow update: if isOwner(listingId) ||
        // Agregado de avaliações (ratingAverage/ratingCount — ver
        // ProviderDirectoryRepository.rate): precisa ser gravável por
        // QUALQUER cliente autenticado, não só o dono do perfil, porque é
        // o cliente que avalia quem atualiza a média. Ressalva honesta:
        // isso só valida formato e que a nota não "recua" mais que uma
        // avaliação de cada vez — não confirma que o número foi calculado
        // certinho a partir da subcoleção `ratings`. Fechar essa brecha de
        // verdade pediria uma Cloud Function recalculando no servidor
        // (ver a nota em ProviderDirectoryRepository.rate).
        (request.auth != null &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['ratingAverage', 'ratingCount']) &&
         request.resource.data.ratingCount is int &&
         request.resource.data.ratingCount >= resource.data.get('ratingCount', 0) &&
         request.resource.data.ratingCount <= resource.data.get('ratingCount', 0) + 1 &&
         request.resource.data.ratingAverage is number &&
         request.resource.data.ratingAverage >= 0 &&
         request.resource.data.ratingAverage <= 5);
      allow delete: if false;

      // Avaliações por estrelas (ver models/provider_rating.dart) — id do
      // documento é o uid de quem avaliou, então só existe uma avaliação
      // por cliente por prestador. Leitura pública (fazem parte do perfil
      // que qualquer um pode ver); escrita só pelo próprio cliente dono da
      // avaliação. A checagem de "só quem contratou pode avaliar" fica no
      // app (ver BudgetRequestsRepository.hasAcceptedBudgetWith) — uma
      // simplificação honesta: nada aqui impede um cliente de forçar a
      // chamada direto sem nunca ter contratado (ver a mesma ressalva em
      // ProviderDirectoryRepository.rate).
      match /ratings/{clientUid} {
        allow read: if true;
        allow create, update: if request.auth != null &&
          request.auth.uid == clientUid &&
          request.resource.data.stars is int &&
          request.resource.data.stars >= 1 &&
          request.resource.data.stars <= 5;
        allow delete: if false;
      }
    }

    // Não existe mais uma coleção `serviceRequests` separada — pedido do
    // Franck: o pedido do cliente já nasce como um orçamento (ver o bloco
    // `budgets` acima, dentro de `providers/{providerId}`). As mesmas
    // regras de lá também valem pra uma consulta `collectionGroup('budgets')`
    // (usada por `BudgetRequestsRepository.watchMine` pra juntar os
    // pedidos do cliente em vários prestadores) — o Firestore casa as
    // regras pelo id da (sub)coleção, não importa a profundidade.

    // Nenhuma outra coleção é acessível pelo cliente. `publicBudgetTokens`
    // (usada para resolver o link público de orçamento) só é lida/escrita
    // pelas Cloud Functions via Admin SDK, que ignora estas regras — por
    // isso nem precisa aparecer aqui.
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
