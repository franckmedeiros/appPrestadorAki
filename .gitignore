/android/app/debug
/android/app/profile
/android/app/release

# scripts/ — chave de admin do Firebase (acesso total ao projeto, nunca
# pode ir pro git) e o CSV real de carga de prestadores (pode ter nomes de
# pessoas reais — o .example.csv com dados fictícios continua versionado).
/scripts/node_modules/
/scripts/*serviceAccount*.json
/scripts/*service-account*.json
/scripts/providers_seed.csv
/scripts/leads_para_contato*.csv
# Carga de prospecção: o CSV de origem, o JSON convertido (1.400+ nomes e
# telefones de pessoas reais) e o mapa de fusões, que também é chaveado por
# telefone. Tudo regenerável a partir do CSV — não há motivo pra esses
# dados ficarem gravados no histórico do git pra sempre.
/scripts/prospeccao_resultados*.csv
/scripts/prestadores_para_importar.json
/scripts/prospeccao_criciuma.csv
/scripts/fusoes.json
# Planilha de consentimento de WhatsApp: mesmos nomes e telefones do CSV
# acima, mais o registro de quem autorizou contato. É a prova de opt-in —
# guarde o arquivo, mas fora do git.
/scripts/base_convite_whatsapp.xlsx
/scripts/base_contatos_export.csv

# Gravações de tela e qualquer mídia pesada. Em 28/09 duas gravações
# (1,25 GB somadas) entraram num `git add -A` e o push morreu com HTTP 408
# — o GitHub recusa arquivo acima de 100 MB, e um binário desse tamanho
# fica no histórico pra sempre mesmo depois de apagado. Guarde os vídeos,
# só não aqui: eles vão pro YouTube, não pro repositório.
/videos/
*.mp4
*.mov

# Material de assinatura iOS: a chave privada, o pedido de certificado e o
# .p12 exportado. Quem tem esses três assina build em nome da conta Apple.
# Moram em ~/chaves-prestadoraki, fora do projeto — isto aqui é só rede de
# segurança pra quando um deles for parar na pasta errada por engano.
*.p12
*.key
*.certSigningRequest
*.cer
*.mobileprovision

# Pasta onde o app do Claude salva o que é entregue na conversa (prévias,
# roteiros, planilhas, vídeos cortados). É material de trabalho, não código
# do app — e foi por aqui que um .mp4 de 6 MB entrou num commit.
/Claude outputs/

# Cache local do Firebase Hosting — gravado a cada `firebase deploy` e sem
# valor pra mais ninguém. Versionar isso faz todo deploy virar sujeira no
# diff do próximo commit.
/.firebase/
