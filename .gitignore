# scripts/ — chave de admin do Firebase (acesso total ao projeto, nunca
# pode ir pro git) e o CSV real de carga de prestadores (pode ter nomes de
# pessoas reais — o .example.csv com dados fictícios continua versionado).
/scripts/node_modules/
/scripts/*serviceAccount*.json
/scripts/*service-account*.json
/scripts/providers_seed.csv
/scripts/leads_para_contato*.csv
# Carga de prospecção: o CSV de origem, o JSON convertido (1.400+ nomes e
# telefones de pessoas reais) e o mapa de fusões, que também é chaveado por
# telefone. Tudo regenerável a partir do CSV — não há motivo pra esses
# dados ficarem gravados no histórico do git pra sempre.
/scripts/prospeccao_resultados*.csv
/scripts/prestadores_para_importar.json
/scripts/prospeccao_criciuma.csv
/scripts/fusoes.json
# Planilha de consentimento de WhatsApp: mesmos nomes e telefones do CSV
# acima, mais o registro de quem autorizou contato. É a prova de opt-in —
# guarde o arquivo, mas fora do git.
/scripts/base_convite_whatsapp.xlsx
/scripts/base_contatos_export.csv
