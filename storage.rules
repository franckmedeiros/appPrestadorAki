rules_version = '2';

// Regras de segurança do Firebase Storage para o PrestadorAki.
// Cole isso no Console do Firebase em: Storage -> Regras (mesma
// convenção do app Resenha, que também mantém o storage.rules no
// repositório só como referência/documentação — o deploy real é manual
// pelo Console, a menos que "storage" seja adicionado ao firebase.json
// pra permitir `firebase deploy --only storage`).
//
// Por enquanto só guarda a logo do prestador (ver ProviderLogoService) —
// um arquivo fixo por uid, então nunca precisa listar nada.
service firebase.storage {
  match /b/{bucket}/o {
    // Logo do prestador — aparece no perfil público do diretório (ver
    // ProviderDirectoryRepository), por isso a leitura é liberada pra
    // qualquer um (mesmo sem estar logado, já que a busca de prestadores
    // também é livre pra visitante). Só o próprio dono (uid batendo com o
    // token de login) pode escrever/substituir a logo dele.
    match /providers/{uid}/logo.jpg {
      allow read: if true;
      allow write: if request.auth != null && request.auth.uid == uid;
    }
  }
}
